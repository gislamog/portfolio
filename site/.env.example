# Cloudflare Web Analytics site token (free).
# Dashboard: https://dash.cloudflare.com/ ? Analytics & logs ? Web Analytics ? Add a site
# Hostname: gislamog.github.io
# Copy the token from the JS snippet (data-cf-beacon token=...).
# Put this file next to package.json as `.env.local` (gitignored) then `npm run deploy`.
VITE_CF_ANALYTICS_TOKEN=

# Formspree form id for the contact form (public by design - it only accepts
# posts). Create a form at https://formspree.io pointed at
# gulsum.islamoglu8@gmail.com, then copy the id from the endpoint URL
# (https://formspree.io/f/<id>). Without this the form falls back to opening
# the visitor's own mail client.
VITE_FORMSPREE_ID=
